#!/usr/bin/env bash

set -euo pipefail

TEST_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT_DIR=$(cd "$TEST_DIR/../../.." && pwd)
SOURCE=$1
shift
BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/dashed-test.XXXXXX")
trap 'rm -rf "$BUILD_DIR"' EXIT
GIST_LIBS=()
if grep -Eq \
    '^[[:space:]]*#define[[:space:]]+GECODE_HAS_GIST([[:space:]]|$)' \
    "$ROOT_DIR/gecode/support/config.hpp"; then
  GIST_LIBS=(-lgecodegist)
fi

echo 'Compiling'
time "${CXX:-g++}" -O0 -ggdb -pipe -Wall -Wno-switch -I"$ROOT_DIR" \
  -std=c++17 -c -o "$BUILD_DIR/test.o" "$SOURCE"

echo 'Linking'
time "${CXX:-g++}" -o "$BUILD_DIR/test" "$BUILD_DIR/test.o" -std=c++17 \
  -L"$ROOT_DIR" -Wl,-rpath,"$ROOT_DIR" \
  -lgecodeflatzinc -lgecodestring -lgecodeint -lgecodeset -lgecodedriver \
  "${GIST_LIBS[@]}" -lgecodesearch \
  -lgecodeminimodel -lgecodekernel -lgecodesupport -pthread

echo 'Executing'
export LD_LIBRARY_PATH="$ROOT_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
last_argument=
if [[ $# -gt 0 ]]; then
  last_argument=${@: -1}
fi
if [[ $last_argument == val ]]; then
  time valgrind --gen-suppressions=yes --leak-check=full \
    "$BUILD_DIR/test" "$@"
else
  time "$BUILD_DIR/test" "$@"
fi
