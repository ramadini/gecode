#!/usr/bin/env bash

TIMEOUT=${SMT_MIN_TIMEOUT:-1000}
infile=$1
obj=$2
init=$3
solver_name=$4
direction=$5

case "$solver_name" in
  z3seq)
    solver=(z3 -in -smt2 smt.string_solver=seq)
    ;;
  cvc5)
    solver=(cvc5 --lang=smt2 --strings-exp --incremental -)
    ;;
  z3noodler)
    solver=(z3-noodler -in -smt2)
    ;;
  z3noodler_mocha)
    solver=(z3-noodler-mocha -in -smt2)
    ;;
  *)
    echo "Unknown SMT solver: $solver_name" >&2
    exit 1
    ;;
esac

WORK=$(mktemp -d)
inpipe="$WORK/pipe.in"
outpipe="$WORK/pipe.out"
mkfifo "$inpipe" "$outpipe"
solver_pid=''
watchdog_pid=''
cleanup() {
  [ -n "$solver_pid" ] && kill "$solver_pid" 2>/dev/null || true
  [ -n "$watchdog_pid" ] && kill "$watchdog_pid" 2>/dev/null || true
  rm -rf "$WORK"
}
trap cleanup EXIT

sleep "$TIMEOUT" > "$inpipe" &
watchdog_pid=$!
"${solver[@]}" < "$inpipe" > "$outpipe" &
solver_pid=$!
cat "$infile" > "$inpipe"
SOL=0
line=''

if read -r line < "$outpipe" && [ "$line" = sat ]; then
  obj_val=$init
  if [ "$direction" = max ]; then
    echo "(assert (>= $obj $obj_val))" > "$inpipe"
  else
    echo "(assert (<= $obj $obj_val))" > "$inpipe"
  fi
  echo '(check-sat)' > "$inpipe"

  while read -r line < "$outpipe"
  do
    [ "$line" = sat ] || break
    SOL=1
    printf '%s = %s\n----------\n' "$obj" "$obj_val"
    if [ "$direction" = max ]; then
      obj_val=$((obj_val + 1))
      echo "(assert (>= $obj $obj_val))" > "$inpipe"
    else
      obj_val=$((obj_val - 1))
      echo "(assert (<= $obj $obj_val))" > "$inpipe"
    fi
    echo '(check-sat)' > "$inpipe"
  done

  if [ "$SOL" -eq 0 ]; then
    SOL=1
    printf '%s = %s\n----------\n' "$obj" "$obj_val"
  fi
fi

if [ "$SOL" -eq 0 ]; then
  if [ "$line" = unsat ]; then
    echo '=====UNSATISFIABLE====='
  else
    echo '=====UNKNOWN====='
  fi
elif [ "$line" = unsat ]; then
  echo '=========='
fi
