#!/usr/bin/env bash

set -o pipefail

EXP_PATH=$(cd "$(dirname "$0")" && pwd)
TIMEOUT=${TIMEOUT:-300}
MAX_INSTANCES=${MAX_INSTANCES:-0}
SOLVERS=${SOLVERS:-"cvc5 z3seq z3noodler z3noodler_mocha"}

ERRORS="$EXP_PATH/errors_smt_sm.log"
OUTPUT="$EXP_PATH/output_smt_sm.log"
RESULTS="$EXP_PATH/results_smt_sm.log"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
ERR="$WORK/tmp.err"
OUT="$WORK/tmp.out"
TIMING="$WORK/tmp.time"
VALUES="$WORK/tmp.values"
SMT="$WORK/tmp.smt2"

OBJ=min
OBJVAR=L
CMD="$EXP_PATH/smt_min"

: > "$ERRORS"
: > "$OUTPUT"
: > "$RESULTS"

mapfile -t instances < <(find "$EXP_PATH/smt" -maxdepth 1 -type f -name 'sm_*.smt2' | sort -V)
if [ "$MAX_INSTANCES" -gt 0 ]; then
  instances=("${instances[@]:0:$MAX_INSTANCES}")
fi

for solver in $SOLVERS
do
  case "$solver" in
  z3seq)
    initial=(z3 -smt2 smt.string_solver=seq)
    ;;
  cvc5)
    initial=(cvc5 --produce-models --lang=smt2 --strings-exp)
    ;;
  z3noodler)
    initial=(z3-noodler -smt2 model=true)
    ;;
  z3noodler_mocha)
    initial=(z3-noodler-mocha -smt2 model=true)
    ;;
  *)
    echo "Unknown SMT solver: $solver" >&2
    exit 1
    ;;
  esac

  for smt in "${instances[@]}"
  do
    header="$solver|$smt"
    echo "$header" | tee -a "$ERRORS" "$OUTPUT"

    echo "Extracting initial bound for $smt..."
    cp "$smt" "$SMT"
    echo '(get-model)' >> "$SMT"

    case "$solver" in
      z3seq|z3noodler|z3noodler_mocha)
        v=$(timeout 1 "${initial[@]}" "$SMT" 2>/dev/null |
            tr '\n' ' ' |
            sed 's/define-fun/\n/g' |
            grep "$OBJVAR ()" |
            awk '{print $4}' |
            sed 's/)//g' |
            head -1)
        ;;
      cvc5)
        v=$(timeout 1 "${initial[@]}" "$SMT" 2>/dev/null |
            grep "$OBJVAR ()" |
            awk '{print $5}' |
            sed 's/)//g' |
            head -1)
        ;;
    esac

    if [ -n "$v" ]; then
      val=$v
    else
      val=$(basename "$smt" | awk -F_ '{print $2}')
    fi

    echo "Initial bound = $val. Solving $smt with $solver..."
    start=$(awk 'BEGIN {print systime()}')
    { time -p unbuffer timeout "$TIMEOUT" "$CMD" "$smt" "$OBJVAR" "$val" "$solver" "$OBJ" 2>"$ERR" |
        gawk -v s="$start" '{print $0, (systime() - s)}' >"$OUT"; } 2>"$TIMING"
    ret=$?
    tot_time=$(awk '/^real / {print $2; exit}' "$TIMING")
    tot_time=${tot_time:-0}

    grep "$OBJVAR = " "$OUT" | awk '{print $3, $4}' | sed 's/;//g' | sed 's/ /_,_/g' > "$VALUES"
    vals='{'
    key=''
    while read -r item
    do
      [ -z "$item" ] && continue
      key=$(echo "$item" | awk -F'_,_' '{print $1}')
      value=$(echo "$item" | awk -F'_,_' '{print $2}')
      vals="$vals$key: $value, "
    done < "$VALUES"
    if [ -z "$key" ]; then val=nan; else val=$key; fi
    vals="$vals}"

    if grep -q '=====UNKNOWN=====' "$OUT"; then
      status=unk
    elif grep -q -- '----------' "$OUT"; then
      if grep -q '==========' "$OUT"; then status=opt; else status=sat; fi
    elif grep -q '=====UNSATISFIABLE=====' "$OUT"; then
      status=uns
    elif [ "$ret" -eq 124 ]; then
      status=unk
    else
      status=err
    fi

    cat "$ERR" >> "$ERRORS"
    cat "$OUT" >> "$OUTPUT"
    echo "$header|$status|$val|$vals|$tot_time" | tee -a "$RESULTS"
  done
done
