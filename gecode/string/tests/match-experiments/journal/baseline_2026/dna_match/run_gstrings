#!/usr/bin/env bash

set -o pipefail

EXP_PATH=$(cd "$(dirname "$0")" && pwd)
TIMEOUT=${TIMEOUT:-300}
MAX_INSTANCES=${MAX_INSTANCES:-0}
SOLVERS=${SOLVERS:-"G-Strings_ori G-Strings_new"} #G-Strings_dec"}

ERRORS="$EXP_PATH/errors_gstrings_dna.log"
OUTPUT="$EXP_PATH/output_gstrings_dna.log"
RESULTS="$EXP_PATH/results_gstrings_dna.log"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
ERR="$WORK/tmp.err"
OUT="$WORK/tmp.out"
TIMING="$WORK/tmp.time"
VALUES="$WORK/tmp.values"
FZN="$WORK/tmp.fzn"

: > "$ERRORS"
: > "$OUTPUT"
: > "$RESULTS"

mapfile -t instances < <(find "$EXP_PATH/dzn" -maxdepth 1 -type f -name '*.dzn' | sort -V)
if [ "$MAX_INSTANCES" -gt 0 ]; then
  instances=("${instances[@]:0:$MAX_INSTANCES}")
fi

for solver in $SOLVERS
do
  case "$solver" in
    G-Strings_ori) mzn="$EXP_PATH/dna.mzn"; define='newM=false' ;;
    G-Strings_new) mzn="$EXP_PATH/dna.mzn"; define='newM=true' ;;
    G-Strings_dec) mzn="$EXP_PATH/dna_dec.mzn"; define='newM=false' ;;
    *) echo "Unknown solver variant: $solver" >&2; exit 1 ;;
  esac

  for dzn in "${instances[@]}"
  do
    header="$solver|$dzn"
    echo "$header" | tee -a "$ERRORS" "$OUTPUT"

    echo "Converting MiniZinc model to FlatZinc..."
    echo "mzn2fzn-gstrings -D\"$define\" $mzn $dzn -o $FZN"
    if ! mzn2fzn-gstrings -D"$define" "$mzn" "$dzn" -o "$FZN" 2>"$ERR"; then
      cat "$ERR" | tee -a "$ERRORS" >&2
      echo "$header|err|nan|{}|0" >> "$RESULTS"
      continue
    fi

    echo "Solving FlatZinc instance..."
    start=$(awk 'BEGIN {print systime()}')
    { time -p unbuffer timeout "$TIMEOUT" fzn-gstrings -decomp-regex 0 -a "$FZN" 2>"$ERR" |
        gawk -v s="$start" '{print $0, (systime() - s)}' >"$OUT"; } 2>"$TIMING"
    ret=$?
    tot_time=$(awk '/^real / {print $2; exit}' "$TIMING")
    tot_time=${tot_time:-0}

    grep 'obj = ' "$OUT" | awk '{print $3, $4}' | sed 's/;//g' | sed 's/ /_,_/g' > "$VALUES"
    vals='{'
    key=''
    while read -r item
    do
      [ -z "$item" ] && continue
      key=$(echo "$item" | awk -F'_,_' '{print $1}')
      value=$(echo "$item" | awk -F'_,_' '{print $2}')
      vals="$vals$key: $value, "
    done < "$VALUES"
    if [ -z "$key" ]; then val=nan; else val=$key; fi
    vals="$vals}"

    if grep -q '=====UNKNOWN=====' "$OUT"; then
      status=unk
    elif grep -q -- '----------' "$OUT"; then
      if grep -q '==========' "$OUT"; then status=opt; else status=sat; fi
    elif grep -q '=====UNSATISFIABLE=====' "$OUT"; then
      status=uns
    elif [ "$ret" -eq 124 ]; then
      status=unk
    else
      status=err
    fi

    cat "$ERR" >> "$ERRORS"
    cat "$OUT" >> "$OUTPUT"
    echo "$header|$status|$val|$vals|$tot_time" | tee -a "$RESULTS"
  done
done
