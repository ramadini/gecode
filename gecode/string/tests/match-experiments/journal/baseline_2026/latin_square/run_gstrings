#!/usr/bin/env bash

set -o pipefail

EXP_PATH=$(cd "$(dirname "$0")" && pwd)
TIMEOUT=${TIMEOUT:-300}
N_MIN=${N_MIN:-1}
N_MAX=${N_MAX:-40}
SOLVERS=${SOLVERS:- "G-Strings_find"} #"G-Strings_new G-Strings_ori"} #G-Strings_dec"}

ERRORS="$EXP_PATH/errors_gstrings_ls.log"
OUTPUT="$EXP_PATH/output_gstrings_ls.log"
RESULTS="$EXP_PATH/results_gstrings_ls.log"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
ERR="$WORK/tmp.err"
OUT="$WORK/tmp.out"
TIMING="$WORK/tmp.time"
FZN="$WORK/tmp.fzn"

: > "$ERRORS"
: > "$OUTPUT"
: > "$RESULTS"

for solver in $SOLVERS
do
  case "$solver" in
    G-Strings_ori) mzn="$EXP_PATH/latin_square.mzn" ;;
    G-Strings_new) mzn="$EXP_PATH/latin_square_new.mzn" ;;
    G-Strings_dec) mzn="$EXP_PATH/latin_square_dec.mzn" ;;
    G-Strings_find) mzn="$EXP_PATH/latin_square_find.mzn" ;;
    *) echo "Unknown solver variant: $solver" >&2; exit 1 ;;
  esac

  for ((i=N_MIN; i<=N_MAX; i++))
  do
    header="$solver|$i"
    echo "$header" | tee -a "$ERRORS" "$OUTPUT"

    echo "Converting MiniZinc model to FlatZinc..."
    echo "mzn2fzn-gstrings -D\"N=$i\" $mzn -o $FZN"
    if ! mzn2fzn-gstrings -D"N=$i" "$mzn" -o "$FZN" 2>"$ERR"; then
      cat "$ERR" | tee -a "$ERRORS" >&2
      echo "$header|err|0" >> "$RESULTS"
      continue
    fi

    echo "Solving FlatZinc instance..."
    start=$(awk 'BEGIN {print systime()}')
    { time -p timeout "$TIMEOUT" fzn-gstrings -s "$FZN" 2>"$ERR" |
        gawk -v s="$start" '{print $0, (systime() - s)}' >"$OUT"; } 2>"$TIMING"
    ret=$?
    tot_time=$(awk '/^real / {print $2; exit}' "$TIMING")
    tot_time=${tot_time:-0}

    if grep -q -- '----------' "$OUT"; then
      status=sat
    elif [ "$ret" -eq 124 ]; then
      status=unk
    else
      status=unk
    fi

    cat "$ERR" >> "$ERRORS"
    cat "$OUT" >> "$OUTPUT"
    echo "$header|$status|$tot_time" | tee -a "$RESULTS"
  done
done
