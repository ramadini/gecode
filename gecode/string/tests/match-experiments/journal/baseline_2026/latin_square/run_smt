#!/usr/bin/env bash

set -o pipefail

EXP_PATH=$(cd "$(dirname "$0")" && pwd)
TIMEOUT=${TIMEOUT:-300}
N_MIN=${N_MIN:-21}
N_MAX=${N_MAX:-40}
SOLVERS=${SOLVERS:-"cvc5 z3seq z3noodler z3noodler_mocha ostrich"}

ERRORS="$EXP_PATH/errors_smt_ls.log"
OUTPUT="$EXP_PATH/output_smt_ls.log"
RESULTS="$EXP_PATH/results_smt_ls.log"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
ERR="$WORK/tmp.err"
OUT="$WORK/tmp.out"
TIMING="$WORK/tmp.time"

: > "$ERRORS"
: > "$OUTPUT"
: > "$RESULTS"

instances=()
for ((n=N_MIN; n<=N_MAX; n++))
do
  smt="$EXP_PATH/smt/ls_${n}.smt2"
  if [ -f "$smt" ]; then
    instances+=("$smt")
  else
    echo "Skipping missing instance: $smt" >&2
  fi
done

if [ "${#instances[@]}" -eq 0 ]; then
  echo "No Latin-square SMT instances found in range $N_MIN..$N_MAX" >&2
  exit 1
fi

for solver in $SOLVERS
do
  case "$solver" in
    z3seq) cmd=(z3 -smt2 smt.string_solver=seq) ;;
    cvc5) cmd=(cvc5 --lang=smt2) ;;
    z3noodler) cmd=(z3-noodler -smt2) ;;
    z3noodler_mocha) cmd=(z3-noodler-mocha -smt2) ;;
    ostrich) cmd=(ostrich +quiet -inputFormat=smtlib) ;;
    *) echo "Unknown SMT solver: $solver" >&2; exit 1 ;;
  esac

  for smt in "${instances[@]}"
  do
    header="$solver|$smt"
    echo "$header" | tee -a "$ERRORS" "$OUTPUT"
    echo "Solving $smt with $solver..."

    start=$(awk 'BEGIN {print systime()}')
    { time -p timeout "$TIMEOUT" "${cmd[@]}" "$smt" 2>"$ERR" |
        gawk -v s="$start" '{print $0, (systime() - s)}' >"$OUT"; } 2>"$TIMING"
    ret=$?
    tot_time=$(awk '/^real / {print $2; exit}' "$TIMING")
    tot_time=${tot_time:-0}

    if grep -Eq '^sat([[:space:]]|$)' "$OUT"; then
      status=sat
    elif grep -Eq '^unsat([[:space:]]|$)' "$OUT"; then
      status=uns
    elif [ "$ret" -eq 124 ] || grep -Eq '^unknown([[:space:]]|$)' "$OUT"; then
      status=unk
    else
      status=err
    fi

    cat "$ERR" >> "$ERRORS"
    cat "$OUT" >> "$OUTPUT"
    echo "$header|$status|$tot_time" | tee -a "$RESULTS"
  done
done
