#!/usr/bin/env bash

set -euo pipefail

TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
GECODE_ROOT="$(cd -- "$TEST_DIR/../../.." && pwd)"
PROJECT_ROOT="$GECODE_ROOT/dashed-project"
PROTOTYPE_ROOT="$PROJECT_ROOT/prototype"

GECODE_BUILD="$GECODE_ROOT/build-list-native"
CORE_BUILD="$PROTOTYPE_ROOT/build-native-core"

JOBS="${JOBS:-1}"

if [[ -e "$GECODE_ROOT/gecode/dashed" || \
      -e "$GECODE_ROOT/gecode/dashed.hh" ]]; then
  echo "Obsolete public Dashed module path still exists." >&2
  exit 1
fi

if grep -RInE \
    'Gecode::Dashed|namespace[[:space:]]+Dashed|GECODE_HAS_DASHED_VARS|<gecode/dashed|Dashed::' \
    --exclude=run-tests \
    "$GECODE_ROOT/gecode/list" \
    "$GECODE_ROOT/gecode/list.hh"; then
  echo "Obsolete Gecode-facing Dashed terminology remains." >&2
  exit 1
fi

if grep -RIn \
    --exclude=run-tests \
    --exclude=domain.hpp \
    --exclude=backend.hpp \
    '[d]ashed::' \
    "$GECODE_ROOT/gecode/list"; then
  echo "The dashed backend leaked outside domain.hpp/backend.hpp." >&2
  exit 1
fi

echo "Gecode root:    $GECODE_ROOT"
echo "Prototype root: $PROTOTYPE_ROOT"
echo "Build jobs:     $JOBS"

cmake \
  -S "$PROTOTYPE_ROOT" \
  -B "$CORE_BUILD" \
  -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DDASHED_BUILD_TESTS=OFF \
  -DDASHED_BUILD_BENCHMARKS=OFF

cmake \
  --build "$CORE_BUILD" \
  --target dashed_core \
  --parallel "$JOBS"

cmake \
  -S "$GECODE_ROOT" \
  -B "$GECODE_BUILD" \
  -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_CXX_FLAGS="-DGECODE_HAS_LIST_VARS=1" \
  -DGECODE_WITH_VIS=gecode/list/var-imp/list.vis \
  -DGECODE_ENABLE_QT=OFF \
  -DGECODE_ENABLE_GIST=OFF \
  -DGECODE_ENABLE_MPFR=OFF \
  -DGECODE_ENABLE_EXAMPLES=OFF \
  -DBUILD_TESTING=OFF \
  -DGECODE_ENABLE_SEARCH=ON \
  -DGECODE_ENABLE_INT_VARS=ON \
  -DGECODE_ENABLE_SET_VARS=OFF \
  -DGECODE_ENABLE_FLOAT_VARS=OFF \
  -DGECODE_ENABLE_MINIMODEL=OFF \
  -DGECODE_ENABLE_DRIVER=OFF \
  -DGECODE_ENABLE_FLATZINC=OFF

cmake \
  --build "$GECODE_BUILD" \
  --parallel "$JOBS"

CXX="${CXX:-g++}"

"$CXX" \
  -std=c++17 \
  -DGECODE_HAS_LIST_VARS=1 \
  -DGECODE_NO_AUTOLINK \
  -I"$GECODE_BUILD" \
  -I"$GECODE_ROOT" \
  -I"$PROTOTYPE_ROOT/include" \
  "$TEST_DIR/rel-test.cpp" \
  "$GECODE_ROOT/gecode/list/list-var-imp.cpp" \
  "$CORE_BUILD/libdashed_core.a" \
  -L"$GECODE_BUILD" \
  -Wl,-rpath,"$GECODE_BUILD" \
  -lgecodeint \
  -lgecodesearch \
  -lgecodekernel \
  -lgecodesupport \
  -pthread \
  -o "$GECODE_BUILD/list-rel-test"

"$GECODE_BUILD/list-rel-test"

NATIVE_SANITIZER_LIFECYCLE_BINARY="$GECODE_BUILD/list-sanitizer-lifecycle"

"$CXX" \
  -std=c++17 \
  -DGECODE_HAS_LIST_VARS=1 \
  -DGECODE_NO_AUTOLINK \
  -I"$GECODE_BUILD" \
  -I"$GECODE_ROOT" \
  -I"$PROTOTYPE_ROOT/include" \
  "$TEST_DIR/sanitizer-lifecycle.cpp" \
  "$GECODE_ROOT/gecode/list/list-var-imp.cpp" \
  "$CORE_BUILD/libdashed_core.a" \
  -L"$GECODE_BUILD" \
  -Wl,-rpath,"$GECODE_BUILD" \
  -lgecodeint \
  -lgecodesearch \
  -lgecodekernel \
  -lgecodesupport \
  -pthread \
  -o "$NATIVE_SANITIZER_LIFECYCLE_BINARY"

"$NATIVE_SANITIZER_LIFECYCLE_BINARY"

DIFFERENTIAL_BINARY="$GECODE_BUILD/list-search-differential"
DIFFERENTIAL_TEST_OBJECT="$GECODE_BUILD/list-search-differential-test.o"
DIFFERENTIAL_LIST_OBJECT="$GECODE_BUILD/list-search-list-var-imp.o"

# Compile the new differential test itself with strict warnings.  The Gecode
# source and generated include trees are system headers for this translation
# unit: the differential gate must not turn pre-existing upstream warnings into
# errors merely because it includes search.hh.
"$CXX" \
  -std=c++17 \
  -Wall \
  -Wextra \
  -Wpedantic \
  -Wconversion \
  -Wshadow \
  -Werror \
  -DGECODE_HAS_LIST_VARS=1 \
  -DGECODE_NO_AUTOLINK \
  -isystem "$GECODE_BUILD" \
  -isystem "$GECODE_ROOT" \
  -isystem "$PROTOTYPE_ROOT/include" \
  -c "$TEST_DIR/differential-search.cpp" \
  -o "$DIFFERENTIAL_TEST_OBJECT"

# ListVarImp is already exercised by the native module regression build above.
# Compile it separately with the same warning policy used by the established
# rel-test path, rather than retroactively imposing new warnings on all of
# upstream Gecode.
"$CXX" \
  -std=c++17 \
  -DGECODE_HAS_LIST_VARS=1 \
  -DGECODE_NO_AUTOLINK \
  -I"$GECODE_BUILD" \
  -I"$GECODE_ROOT" \
  -I"$PROTOTYPE_ROOT/include" \
  -c "$GECODE_ROOT/gecode/list/list-var-imp.cpp" \
  -o "$DIFFERENTIAL_LIST_OBJECT"

"$CXX" \
  "$DIFFERENTIAL_TEST_OBJECT" \
  "$DIFFERENTIAL_LIST_OBJECT" \
  "$CORE_BUILD/libdashed_core.a" \
  -L"$GECODE_BUILD" \
  -Wl,-rpath,"$GECODE_BUILD" \
  -lgecodeint \
  -lgecodesearch \
  -lgecodekernel \
  -lgecodesupport \
  -pthread \
  -o "$DIFFERENTIAL_BINARY"

differential_directory="$(mktemp -d)"
cleanup_differential() {
  rm -rf "$differential_directory"
}
trap cleanup_differential EXIT

reference_report="$differential_directory/reference.tsv"
native_report="$differential_directory/native.tsv"
native_stats="$differential_directory/native-stats.tsv"

python3 \
  "$PROTOTYPE_ROOT/tools/generate_gstrings_solution_reference.py" \
  --report "$reference_report"

"$DIFFERENTIAL_BINARY" \
  --report "$native_report" \
  --stats "$native_stats"

python3 \
  "$PROTOTYPE_ROOT/tools/compare_solution_reports.py" \
  --expected "$reference_report" \
  --actual "$native_report"

python3 \
  "$PROTOTYPE_ROOT/tools/validate_search_stats.py" \
  --expected "$PROTOTYPE_ROOT/tests/gstrings/expected-search-counts.tsv" \
  --actual "$native_stats"
