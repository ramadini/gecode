#!/bin/sh

set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
LOCK_FILE="$ROOT_DIR/tools/minizinc-string/archaeology/upstream-2.0.97.lock"
WORK_DIR="${MZN_STRING_WORK_DIR:-$ROOT_DIR/tools/minizinc-string/.work}"
SOURCE_DIR="$WORK_DIR/libminizinc-2.0.97"

repository=$(sed -n 's/^repository=//p' "$LOCK_FILE")
commit=$(sed -n 's/^commit=//p' "$LOCK_FILE")

if [ -d "$SOURCE_DIR/.git" ]; then
  test "$(git -C "$SOURCE_DIR" config --get remote.origin.url)" = "$repository" ||
    { echo "unexpected origin for $SOURCE_DIR" >&2; exit 1; }
  test -z "$(git -C "$SOURCE_DIR" status --porcelain)" ||
    { echo "refusing to update dirty checkout: $SOURCE_DIR" >&2; exit 1; }
else
  test ! -e "$SOURCE_DIR" ||
    { echo "source path is not a Git checkout: $SOURCE_DIR" >&2; exit 1; }
  mkdir -p "$WORK_DIR"
  git clone "$repository" "$SOURCE_DIR"
fi

git -C "$SOURCE_DIR" fetch --tags origin
git -C "$SOURCE_DIR" cat-file -e "$commit^{commit}" ||
  { echo "required commit is unavailable: $commit" >&2; exit 1; }
git -C "$SOURCE_DIR" checkout --detach "$commit"
test "$(git -C "$SOURCE_DIR" rev-parse HEAD)" = \
  "$(git -C "$SOURCE_DIR" rev-parse "$commit")" ||
  { echo "checkout did not resolve to $commit" >&2; exit 1; }

printf 'Fetched libminizinc %s at %s\n' "$repository" \
  "$(git -C "$SOURCE_DIR" rev-parse HEAD)"
