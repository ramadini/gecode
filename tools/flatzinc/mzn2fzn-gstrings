#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)

exec "$SCRIPT_DIR/mzn2fzn-str" --no-output-ozn \
	--stdlib-dir "$ROOT_DIR/gecode/flatzinc" \
	-I "$ROOT_DIR/gecode/flatzinc/string" \
	-I "$ROOT_DIR/gecode/flatzinc/javascript" "$@"
